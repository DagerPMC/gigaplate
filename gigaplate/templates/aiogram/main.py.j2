import asyncio
import logging

from aiogram import Bot, Dispatcher

from {{ name }}.config import init_config, get_config
from {{ name }}.controllers.router import router
from {{ name }}.middlewares.throttling import ThrottlingMiddleware

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)


async def main() -> None:
    config = init_config()

    bot = Bot(token=config.token)
    dp = Dispatcher()

    dp.message.middleware(ThrottlingMiddleware())
    dp.include_router(router)

    logger.info("Starting bot...")

    if config.updates_strategy == "polling":
        await dp.start_polling(bot)
    else:
        raise ValueError(f"Unknown updates strategy: {config.updates_strategy}")


if __name__ == "__main__":
    asyncio.run(main())
