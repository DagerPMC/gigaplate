[project]
name = "{{ name }}"
version = "0.1.0"
description = ""
requires-python = ">=3.14"
dependencies = [
    "pyyaml>=6.0",
    "pydantic>=2.0",
{% if has_fastapi %}
    "fastapi>=0.100",
    "uvicorn[standard]>=0.20",
    "orjson>=3.9",
{% endif %}
{% if has_sqlalchemy %}
    "sqlalchemy[asyncio]>=2.0",
    "alembic>=1.12",
    "asyncpg>=0.28",
    "uuid-utils>=0.9",
{% endif %}
{% if has_redis %}
    "redis[hiredis]>=5.0",
{% endif %}
{% if has_aiogram %}
    "aiogram>=3.0",
    "aiohttp>=3.9",
{% endif %}
{% if has_cli %}
    "click>=8.0",
{% endif %}
]

[project.optional-dependencies]
dev = [
    "ipython>=8.0",
    "ruff>=0.1",
    "mypy>=1.5",
{% if has_sqlalchemy %}
    "types-PyYAML>=6.0",
{% endif %}
{% if has_pytest %}
    "pytest>=8.0",
    "pytest-asyncio>=0.23",
{% endif %}
]
{% if has_cli %}

[project.scripts]
{{ name }} = "{{ name }}.cli:cli"
{% endif %}

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"
